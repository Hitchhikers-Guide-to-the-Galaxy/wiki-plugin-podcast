{
  "name": "wiki-plugin-podcast",
  "version": "0.4.0",
  "description": "Federated Wiki - Podcast plugin: any podcast link in, its open RSS feed out, then podcast and episode pages built from the feed, kept current, searchable, and the audio you cite archived with its provenance.",
  "type": "module",
  "bin": {
    "find-feed": "bin/find-feed.js",
    "feed-to-page": "bin/feed-to-page.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/unit.test.js test/page.test.js test/client.test.js test/archive.test.js test/update.test.js",
    "test:live": "node --test --test-concurrency=1 test/live.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "David Bovill",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "main": "client/podcast.js",
  "files": [
    "client",
    "pages",
    "api",
    "src/core",
    "bin",
    "factory.json"
  ],
  "fedwiki": {
    "api": {
      "version": 1,
      "spec": "api/openapi.json",
      "handlers": "api/handlers.js"
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-podcast.git"
  },
  "bugs": {
    "url": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-podcast/issues"
  },
  "homepage": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-podcast#readme",
  "keywords": [
    "wiki",
    "federated wiki",
    "plugin",
    "podcast",
    "rss"
  ]
}
